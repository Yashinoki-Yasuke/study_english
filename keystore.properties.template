# リリース署名用の設定テンプレート。
# このファイルをコピーして keystore.properties を作成し、実際の値を記入する。
#   cp keystore.properties.template keystore.properties
# keystore.properties と .jks は .gitignore 済み（絶対にコミットしないこと）。
#
# キーストア(.jks)の作り方（例）:
#   keytool -genkeypair -v -keystore release.jks -alias study_english \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile はプロジェクトルートからの相対パス、または絶対パスで指定。

storeFile=release.jks
storePassword=ここにキーストアのパスワード
keyAlias=study_english
keyPassword=ここに鍵のパスワード
